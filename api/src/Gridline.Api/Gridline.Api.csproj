<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gridline</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefineConstants Condition="'$(NoOpenApi)' == 'true'">$(DefineConstants);NO_OPENAPI</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" Condition="'$(NoOpenApi)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="appsettings.*.private.json" />
    <None Include="appsettings.*.private.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Development.private.json')" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gridline.Api.Tests" />
  </ItemGroup>
</Project>
